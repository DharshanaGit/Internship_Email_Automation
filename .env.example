# Shortfundly Campus Outreach Portal - Environment Template
NODE_ENV=development
JWT_SECRET=replace_with_a_secure_random_32_character_secret_string
SESSION_MAX_AGE_SEC=28800

# Company Administrator Bootstrap Credentials
ADMIN_EMAIL=campus@shortfundly.com
ADMIN_PASSWORD=SetAStrongPassword#2026

# Google SMTP Mailer Configuration
# Generate a 16-character App Password at: https://myaccount.google.com/apppasswords
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=your_google_email@gmail.com
SMTP_PASS=your_16_char_google_app_password
FROM_EMAIL=campus@shortfundly.com
FROM_NAME="Shortfundly Campus Outreach"

# Safeguards & Policies
DUPLICATE_COOLDOWN_DAYS=30
RATE_LIMIT_LOGIN_MAX=5
RATE_LIMIT_LOGIN_WINDOW_SEC=900
RATE_LIMIT_SEND_MAX=30
RATE_LIMIT_SEND_WINDOW_SEC=3600
