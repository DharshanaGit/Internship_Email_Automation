generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id           String   @id @default(cuid())
  email        String   @unique
  passwordHash String
  name         String
  role         String   @default("ADMIN")
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
}

model InternshipBatch {
  id             String      @id @default(cuid())
  batchName      String      @unique
  roles          String      // JSON string array of approved roles
  stipend        String      @default("Rs. 10,000")
  joiningDate    String
  endDate        String
  duration       String
  commonDeadline DateTime?
  googleFormUrl  String?
  googleFormId   String?
  status         String      @default("Active") // Active, Completed, Archived
  candidates     Candidate[]
  createdAt      DateTime    @default(now())
  updatedAt      DateTime    @updatedAt
}

model OfferTemplate {
  id          String   @id @default(cuid())
  name        String   @unique
  subject     String
  emailBody   String
  pdfTemplate String
  isDefault   Boolean  @default(false)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model CandidateOfferAcceptance {
  id              String   @id @default(cuid())
  candidateId     String   @unique
  candidateName   String
  internId        String
  role            String
  stipend         String
  joiningDate     String
  signatureType   String   // TYPED, DRAWN, UPLOADED
  signatureData   String   // text, data URI, or URL
  ipAddress       String?
  userAgent       String?
  acceptedAt      DateTime @default(now())
  originalPdfPath String?
}

model Candidate {
  id                 String           @id @default(cuid())
  candidateId        String           @unique
  internId           String?          @unique
  batch              String?
  batchId            String?
  batchRel           InternshipBatch? @relation(fields: [batchId], references: [id], onDelete: SetNull)
  googleResponseId   String?          @unique
  fullName           String
  email              String
  phone              String?
  role               String
  department         String
  collegeName        String?
  degree             String?
  studentStatus      String?          @default("Ongoing")
  joiningDate        String
  endDate            String
  duration           String
  workMode           String           @default("Online - Remote")
  reportingManager   String
  assignedMentor     String
  stipend            String?          @default("Rs. 10,000")
  offerLetterStatus  String           @default("Ready to Send") // Ready to Send, Queued, Sent, Accepted, Rejected, Expired
  offerDeliveryStatus String          @default("Not Sent")     // Not Sent, Queued, Sent, Delivered, Failed
  offerLetterSentAt  DateTime?
  taskStatus         String           @default("Not Assigned")
  tasksCompleted     Int              @default(0)
  reviewCycle        Int              @default(0)
  score              Float            @default(0.0)
  performancePercentage Float         @default(100.0)
  offerAcceptanceToken String?        @unique
  offerAcceptanceTokenHash String?    @unique
  offerDeadline      DateTime?
  offerAcceptedAt    DateTime?
  offerRejectedAt    DateTime?
  rejectionReason    String?
  signatureType      String?          // TYPED, DRAWN, UPLOADED
  signatureData      String?          // Base64 or plain text
  signatureUrl       String?
  signaturePublicId  String?
  offerPdfPath       String?
  googleMeetUrl      String?          @map("google_meet_url")
  googleCalendarEventId String?       @map("google_calendar_event_id")
  googleMeetStatus   String           @default("NOT_CREATED") @map("google_meet_status")
  interviewDate      String?          @map("interview_date")
  remarks            String?
  createdAt          DateTime         @default(now())
  updatedAt          DateTime         @updatedAt
  tasks              TaskAssignment[]
  emails             EmailLog[]
  certificates       Certificate[]
}

model TaskAssignment {
  id                 String    @id @default(cuid())
  candidateId        String
  candidate          Candidate @relation(fields: [candidateId], references: [id], onDelete: Cascade)
  taskNumber         Int       @default(1)
  taskId             String?
  taskName           String?
  title              String
  objective          String?
  modules            String?
  toolsAndTech       String?
  clientRequirements String?
  description        String
  role               String
  explanationDate    String
  explanationTime    String
  meetLink           String
  reviewDate         String
  reviewTime         String
  deadline           DateTime?
  scheduledSendAt    DateTime?
  isSent             Boolean   @default(true)
  submissionToken    String?   @unique
  submissionStatus   String    @default("PENDING")
  projectUrl         String?
  githubUrl          String?
  submissionDocs     String?
  submittedAt        DateTime?
  warningSentAt      DateTime?
  warningDeadline    DateTime?
  penaltyApplied     Float     @default(0.0)
  status             String    @default("Assigned")
  feedback           String?
  firstReviewDate    String?
  firstReviewStatus  String?   @default("Pending")
  secondReviewDate   String?
  secondReviewStatus String?   @default("Pending")
  secondReviewFeedback String?
  reviewCount        Int       @default(0)
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt
}

model EmailLog {
  id             String     @id @default(cuid())
  candidateId    String?
  candidate      Candidate? @relation(fields: [candidateId], references: [id], onDelete: Cascade)
  recipientEmail String
  recipientName  String?
  cc             String?
  subject        String
  emailType      String
  body           String
  attachments    String?
  meetLink       String?
  status         String     @default("Sent")
  error          String?
  sentAt         DateTime   @default(now())
}

model Certificate {
  id                String    @id @default(cuid())
  candidateId       String
  candidate         Candidate @relation(fields: [candidateId], references: [id], onDelete: Cascade)
  certificateNumber String    @unique
  issueDate         String
  pdfPath           String?
  sentAt            DateTime?
  createdAt         DateTime  @default(now())
}

model SystemSetting {
  id                      String   @id @default("default")
  smtpHost                String?  @default("smtp.gmail.com")
  smtpPort                Int?     @default(465)
  smtpSecure              Boolean  @default(true)
  smtpUser                String?  @default("hr@shortfundly.com")
  smtpPass                String?
  senderEmail             String?  @default("hr@shortfundly.com")
  senderName              String?  @default("Shortfundly HR Team")
  googleCalendarConnected Boolean  @default(false)
  defaultMeetLinkPrefix   String?  @default("https://meet.google.com")
  simulationMode          Boolean  @default(false)
  updatedAt               DateTime @updatedAt
}

model EmailQueue {
  id          String    @id @default(cuid())
  type        String    // OFFER_LETTER, TASK_ASSIGNMENT, REVIEW, CERTIFICATE
  candidateId String?
  payload     String    // JSON string containing parameters
  status      String    @default("PENDING") // PENDING, PROCESSING, COMPLETED, FAILED
  attempts    Int       @default(0)
  error       String?
  scheduledAt DateTime  @default(now())
  processedAt DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
}
